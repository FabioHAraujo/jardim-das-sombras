# ==============================================================================
# Jardim das Sombras - Variáveis de Ambiente do Docker Compose
# COPIE ESTE ARQUIVO PARA .env E AJUSTE SUAS CHAVES ANTES DE SUBIR OS CONTAINERS:
# cp .env.example .env
# ==============================================================================

# Porta da API no Host
PORT=3040

# Chave secreta de autenticação da API (altere em produção)
API_KEY=jardim_secret_api_key_2026

# Domínio público ou proxy reverso (Cloudflare) para os links de compartilhamento
PUBLIC_URL=http://localhost:3040

# BotAPI (ravena-ai) — webhook de colheita para creditar bônus no bot (iscas, rolls, fichas).
# Vazio = push desligado; o bot reconcilia os bônus no próximo comando do jogador.
# URL base da BotAPI (ravena-ai). Alternativas: http://host.docker.internal:5001
# (requer extra_hosts, já no compose) ou http://IP-DO-HOST:5001
BOT_API_URL=http://host.docker.internal:5001
# Chave enviada no header x-api-key do webhook. Vazio = usa a API_KEY acima
# (precisa ser igual à JARDIM_API_KEY configurada na ravena-ai).
BOT_API_TOKEN=

# Token do Bot do Telegram para testes
TELEGRAM_BOT_TOKEN=seu_telegram_bot_token_aqui

# Credenciais do PostgreSQL
POSTGRES_USER=jardim
POSTGRES_PASSWORD=jardim_secret_pass_123
POSTGRES_DB=jardim_das_sombras
POSTGRES_PORT=5434
